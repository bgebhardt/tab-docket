{
  "manifest_version": 3,
  "name": "Tab Stash",
  "version": "0.1.0",
  "description": "A visible working set of tabs. Send tabs to named groups and see them every time you open a new tab.",
  "permissions": ["bookmarks", "tabs", "storage", "favicon"],
  "action": {
    "default_title": "Stash tab",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Stash the current tab"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

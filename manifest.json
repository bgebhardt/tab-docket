{
  "manifest_version": 3,
  "name": "Tab Stash",
  "version": "0.2.0",
  "description": "A visible working set of tabs. Send tabs to named groups, stash the current tab with one shortcut, and keep the list one keystroke away.",
  "permissions": ["bookmarks", "tabs", "storage", "favicon"],
  "action": {
    "default_title": "Stash tab",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open the stash popup (pick a group)"
    },
    "quick-stash": {
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac": "Alt+Shift+Q"
      },
      "description": "Quick stash: save the current tab and close it, no popup"
    },
    "open-board": {
      "suggested_key": {
        "default": "Alt+Shift+O",
        "mac": "Alt+Shift+O"
      },
      "description": "Open the stash page"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
